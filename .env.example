# Números autorizados (separados por vírgula, com DDI+DDD)
ALLOWED_NUMBERS=5511999999999

# Caminho do executável do Antigravity no Windows
ANTIGRAVITY_EXE=C:/Users/brandon/AppData/Local/Programs/antigravity/Antigravity.exe

# Porta CDP (evitar 9222 pois o msedge.exe pode ocupá-la no Windows)
ANTIGRAVITY_CDP_PORT=9229

# Opcional: user-data-dir separado para testes (deixe vazio para usar o perfil padrão)
ANTIGRAVITY_USER_DATA_DIR=

# Projeto padrão (chave em config/projects.json)
DEFAULT_PROJECT=bridge

# Segurança (Etapa 4)
SESSION_PIN=1234
PIN_TIMEOUT_MINUTES=30
AUTO_APPROVE_DEFAULT=false

# Monitoramento
PROGRESS_INTERVAL_SECONDS=180
PREVENT_SLEEP=true
